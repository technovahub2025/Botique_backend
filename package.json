{
  "name": "loom-and-luster-backend",
  "version": "1.0.0",
  "description": "Backend API for Loom & Luster luxury Indian fashion boutique",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed/seed.js",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "jest": {
    "testEnvironment": "node",
